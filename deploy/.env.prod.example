# Quick production env template (single VPS)
# Copy this file to /opt/quick/.env and replace all CHANGE_ME_* values.

POSTGRES_USER=quick
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=news_prod
POSTGRES_PORT=5432
TZ=UTC

DB_HOST=127.0.0.1
DB_SSL_MODE=disable
DB_TIMEZONE=UTC

SERVER_PORT=8080
ADMIN_AUTH_ENABLED=true
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

WORKER_TICK_SEC=30
WORKER_REQUEST_RETRIES=2
WORKER_RETRY_BASE_SEC=2
WORKER_BACKOFF_MAX_FACTOR=16
WORKER_USER_AGENT=Mozilla/5.0 (compatible; QuickRSS/0.1; +https://urwhaturead.com/contact)
WORKER_DEBUG_HTTP=false
WORKER_DEBUG_HOSTS=

CLUSTER_VECTOR_ENABLED=true
CLUSTER_VECTOR_MAX_DISTANCE=0.2
CLUSTER_VECTOR_MIN_TOKENS=3
CLUSTER_VECTOR_IVFFLAT_LISTS=100
CLUSTER_BACKFILL_BATCH_SIZE=500

AI_SUMMARY_ENABLED=true
AI_SUMMARY_BASE_URL=http://127.0.0.1:3000/gemini-cli-oauth/v1/chat/completions
AI_SUMMARY_API_KEY=CHANGE_ME_AI_API_KEY
AI_SUMMARY_MODEL=gemini-2.5-flash
AI_SUMMARY_TIMEOUT_SEC=60
AI_SUMMARY_MAX_INPUT_CHARS=12000
AI_SUMMARY_MAX_OUTPUT_TOKENS=1000
AI_SUMMARY_API_STYLE=openai_chat
AI_SUMMARY_API_KEY_HEADER=Authorization
AI_SUMMARY_API_KEY_PREFIX=Bearer
FEED_BRIEFING_RATE_LIMIT_PER_HOUR=10
FEED_BRIEFING_COOLDOWN_SEC=600

EXTERNAL_FETCH_ENABLED=true
EXTERNAL_FETCH_ALLOWED_HOSTS=
EXTERNAL_FETCH_DAILY_REQUEST_LIMIT=500
EXTERNAL_FETCH_DAILY_BYTE_LIMIT_MB=512
EXTERNAL_FETCH_CACHE_TTL_MIN=1440
EXTERNAL_FETCH_FAILURE_TTL_MIN=60
EXTERNAL_FETCH_MAX_BODY_KB=3072

# Keep pgAdmin disabled in production unless you explicitly need it.
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
